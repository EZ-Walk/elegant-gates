# VHF14 Environment Configuration
# Copy this file to .env and fill in your actual values

# Mapbox configuration (required for map frontend)
# Get your token from https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=pk.eyJ1IjoieW91cl91c2VybmFtZSIsImEiOiJjbGVuOXA0bXUwMXpjNDVyd3h3eTk5aDh2In0.your_token_here
# Important: VITE_MAPBOX_TOKEN is required for frontend build process
VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91cl91c2VybmFtZSIsImEiOiJjbGVuOXA0bXUwMXpjNDVyd3h3eTk5aDh2In0.your_token_here

# Whisper transcription model (optional, defaults to base.en)
# Options: tiny, base, small, medium, large, large-v2, large-v3
# Add .en suffix for English-only models (faster, more accurate for English)
WHISPER_MODEL=base.en

# Gemini AI configuration (required for entity extraction)
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# LM Studio fallback configuration (optional)
# Used if Gemini API is unavailable
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-3-1b

# Ollama fallback configuration (optional)  
OLLAMA_MODEL=phi3